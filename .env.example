# Copy this file to .env and replace every CHANGE_ME value before deployment.
# Do not commit the resulting .env file.

# Public application address and API CORS allow-list
APP_ORIGIN=http://localhost:8080,http://localhost:5173
WEB_PORT=8080
VITE_API_BASE_URL=/api
DEV_API_PROXY_TARGET=http://localhost:5000
API_UPSTREAM=backend:5000

# Backend
NODE_ENV=production
BACKEND_PORT=5000
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=8h
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
UPLOAD_MAX_MB=5

# MySQL-compatible TiDB Cloud or local Compose database.
# For TiDB Cloud use DB_SSL=true and set DB_CA_CERT_PATH to the downloaded CA file.
DB_HOST=db
DB_PORT=3306
DB_NAME=leave_management
DB_USER=leave_app
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DB_SSL=false
DB_CA_CERT_PATH=
DB_ROOT_PASSWORD=CHANGE_ME_ROOT_DATABASE_PASSWORD

# Optional LLM provider - kept solely on the backend.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Optional email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Development/demo seeding - required only for `npm run seed`.
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_DEMO_PASSWORD
SEED_FACULTY_PASSWORD=CHANGE_ME_FACULTY_DEMO_PASSWORD
SEED_STUDENT_PASSWORD=CHANGE_ME_STUDENT_DEMO_PASSWORD
SEED_ADMIN_EMAIL=admin@demo.local
SEED_ADMIN_NAME=Demo Administrator
SEED_FACULTY_EMAIL=faculty@demo.local
SEED_FACULTY_ID=FAC1001
SEED_FACULTY_NAME=Demo Faculty
SEED_STUDENT_EMAIL=student@demo.local
SEED_EMAIL_DOMAIN=demo.local
